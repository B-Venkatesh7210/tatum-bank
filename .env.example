NODE_ENV=development
PORT=3000

# Required for /auth and JWT-protected routes
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

TATUM_API_KEY=
# Optional override (default https://api.tatum.io)
TATUM_API_BASE_URL=

# Webhook + ledger (PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/tatum_bank
# Same secret as PUT https://api.tatum.io/v4/subscription { "hmacSecret": "..." }
TATUM_WEBHOOK_HMAC_SECRET=
# Dev only — never set in production
WEBHOOK_SKIP_HMAC_VERIFY=false

# Tatum KMS (off-chain withdrawals) — wallet signature UUIDs from tatum-kms
TATUM_KMS_SIGNATURE_ID_ETH=
TATUM_KMS_SIGNATURE_ID_MATIC=
TATUM_KMS_SIGNATURE_ID_BTC=
TATUM_KMS_DERIVATION_INDEX=0
# Log pending KMS template IDs (no signing performed in-app)
TATUM_KMS_SIMULATE_LOGGING=false

# Transak on-ramp (https://docs.transak.com/)
TRANSAK_USE_STAGING=true
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
# Hostname only (e.g. localhost:5173 or app.example.com)
TRANSAK_REFERRER_DOMAIN=
TRANSAK_DEFAULT_FIAT_AMOUNT=100
TRANSAK_FIAT_CURRENCY=USD
